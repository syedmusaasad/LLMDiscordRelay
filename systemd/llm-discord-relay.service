[Unit]
Description=LLM Discord Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RELAY_LLMUX_BIN=%h/.local/bin/llmux
EnvironmentFile=-%h/.config/llm-discord-relay/.env
ExecStart=%h/.local/bin/relay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
